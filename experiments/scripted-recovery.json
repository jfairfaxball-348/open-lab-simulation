{
  "schema": "open-lab/experiment-config",
  "schema_version": "1.1.0",
  "experiment_id": "scripted-recovery",
  "title": "Engineering check: supervisor checkpoint recovery",
  "research_question": "None. This is an engineering check that a run is launched, supervised and recorded end to end. The replies are fixed in advance, so it says nothing about how any agent behaves.",
  "created_at": "2026-11-14T10:00:00Z",
  "tags": [
    "scripted",
    "engineering-check"
  ],
  "initial_prompt": "Explore the world and keep working notes for later.",
  "world": {
    "world_id": "minimal",
    "version": "0.6.0"
  },
  "orchestrator": {
    "provider_id": "scripted",
    "model_id": "scripted"
  },
  "limits": {
    "wall_clock_s": 20,
    "max_steps": 8
  },
  "permissions": {
    "filesystem": "workspace_write",
    "network": "none"
  },
  "termination": {
    "on_deadline": "hard_stop"
  },
  "extensions": {
    "scripted_model": {
      "replies": [
        {
          "text": "Saving working notes.",
          "delay_s": 0.5,
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "workspace.write",
                "arguments": {
                  "path": "NOTES.md",
                  "text": "Working notes before pause.\n"
                }
              }
            }
          ]
        },
        {
          "text": "Saving memory.",
          "delay_s": 1,
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "memory.write",
                "arguments": {
                  "key": "plan",
                  "value": "first"
                }
              }
            }
          ]
        }
      ]
    },
    "recovery": {
      "max_restarts": 2,
      "auto_resume": true,
      "health_check_interval_s": 5,
      "health_check_timeout_s": 2
    }
  },
  "checkpointing": {
    "interval_s": 1,
    "keep_last": 5
  }
}
