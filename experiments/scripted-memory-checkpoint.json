{
  "schema": "open-lab/experiment-config",
  "schema_version": "1.1.0",
  "experiment_id": "scripted-memory-checkpoint",
  "title": "Scripted memory and checkpoint engineering check",
  "research_question": "None. This is an engineering check that a run is launched, supervised and recorded end to end. The replies are fixed in advance, so it says nothing about how any agent behaves.",
  "created_at": "2026-11-14T10:00:00Z",
  "tags": [
    "scripted",
    "engineering-check"
  ],
  "initial_prompt": "Explore the world and keep working notes for later.",
  "world": {
    "world_id": "minimal",
    "version": "0.6.0"
  },
  "orchestrator": {
    "provider_id": "scripted",
    "model_id": "scripted"
  },
  "limits": {
    "wall_clock_s": 60,
    "max_steps": 10
  },
  "permissions": {
    "filesystem": "workspace_write",
    "network": "none"
  },
  "termination": {
    "on_deadline": "hard_stop"
  },
  "extensions": {
    "scripted_model": {
      "replies": [
        {
          "text": "Remembering a note.",
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "memory.write",
                "arguments": {
                  "key": "plan",
                  "value": "first"
                }
              }
            }
          ]
        },
        {
          "text": "Keeping working notes.",
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "workspace.write",
                "arguments": {
                  "path": "NOTES.md",
                  "text": "Working notes before pause.\n"
                }
              }
            }
          ]
        },
        {
          "text": "Recalling memory.",
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "memory.search",
                "arguments": {
                  "query": "plan"
                }
              }
            },
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "memory.list",
                "arguments": {}
              }
            }
          ]
        },
        {
          "text": "Revising memory and working notes.",
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "memory.write",
                "arguments": {
                  "key": "plan",
                  "value": "revised"
                }
              }
            },
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "workspace.write",
                "arguments": {
                  "path": "NOTES.md",
                  "text": "Working notes after resume.\n",
                  "overwrite": true
                }
              }
            }
          ]
        },
        {
          "text": "Saving the result.",
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "workspace.write",
                "arguments": {
                  "path": "result.txt",
                  "text": "Checkpoint continuation completed.\n"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "checkpointing": {
    "interval_s": 1,
    "keep_last": 5
  }
}
