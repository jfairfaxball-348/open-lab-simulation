{
  "schema": "open-lab/experiment-config",
  "schema_version": "1.0.0",
  "experiment_id": "scripted-resources",
  "title": "Engineering check: resource limits and samples",
  "research_question": "None. This is an engineering check that a run is launched, supervised and recorded end to end. The replies are fixed in advance, so it says nothing about how any agent behaves.",
  "created_at": "2026-11-13T23:30:00Z",
  "tags": [
    "scripted",
    "engineering-check"
  ],
  "initial_prompt": "You exist inside a computational world. Nobody will send you further instructions. You may use whatever you find in it.",
  "world": {
    "world_id": "minimal",
    "version": "0.6.0"
  },
  "orchestrator": {
    "provider_id": "scripted",
    "model_id": "scripted"
  },
  "limits": {
    "wall_clock_s": 20,
    "max_steps": 10,
    "resources": {
      "ram_mb": 256,
      "max_processes": 8,
      "cpu_cores": 1,
      "disk_mb": 1
    }
  },
  "permissions": {
    "filesystem": "workspace_write",
    "network": "none"
  },
  "termination": {
    "on_deadline": "hard_stop"
  },
  "extensions": {
    "resource_sampling": {
      "interval_s": 0.2
    },
    "scripted_model": {
      "replies": [
        {
          "delay_s": 0.3,
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "text.stats",
                "arguments": {
                  "text": "Resource sampling check."
                }
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "workspace.write",
                "arguments": {
                  "path": "NOTES.md",
                  "text": "Bounded resource engineering check.\n"
                }
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "capability_id": "capabilities.invoke",
              "arguments": {
                "id": "workspace.list",
                "arguments": {}
              }
            }
          ]
        }
      ]
    }
  }
}
