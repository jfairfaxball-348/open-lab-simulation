{
  "schema": "open-lab/capability",
  "schema_version": "1.0.1",
  "id": "stats.describe",
  "version": "0.1.0",
  "name": "Describe numeric data",
  "summary": "Compute count, mean, median, population variance, standard deviation and quartiles.",
  "description": "Summarize a bounded list of finite JSON numbers. Variance and standard deviation describe the supplied population (divisor n, not sample divisor n-1). Quartiles q1/q2/q3 are the 25th/50th/75th percentiles, using inclusive endpoint linear interpolation (Python statistics.quantiles inclusive). Singleton quartiles all equal the sole value. Returns rounded binary floating-point values, not exact symbolic results. No files are read or written.",
  "categories": [
    "statistics",
    "math"
  ],
  "keywords": [
    "statistics",
    "data",
    "average",
    "mean",
    "median",
    "variance",
    "deviation",
    "quantiles",
    "quartiles",
    "distribution",
    "summary"
  ],
  "invocation": {
    "interface": "python",
    "entrypoint": "implementation:run"
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "values"
    ],
    "properties": {
      "values": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10000,
        "items": {
          "type": "number",
          "minimum": -1000000000000.0,
          "maximum": 1000000000000.0
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "count",
      "mean",
      "median",
      "variance",
      "stdev",
      "quantiles"
    ],
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      },
      "mean": {
        "type": "number"
      },
      "median": {
        "type": "number"
      },
      "variance": {
        "type": "number",
        "minimum": 0
      },
      "stdev": {
        "type": "number",
        "minimum": 0
      },
      "quantiles": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q1",
          "q2",
          "q3"
        ],
        "properties": {
          "q1": {
            "type": "number"
          },
          "q2": {
            "type": "number"
          },
          "q3": {
            "type": "number"
          }
        }
      }
    }
  },
  "permissions": {
    "filesystem": "none",
    "network": "none"
  },
  "resources": {
    "timeout_s": 5,
    "typical_duration_s": 0.02,
    "ram_mb": 32
  },
  "demonstrations": [
    {
      "id": "four-values",
      "title": "Four unsorted observations",
      "input": {
        "values": [
          4,
          1,
          3,
          2
        ]
      },
      "expected_output": {
        "count": 4,
        "mean": 2.5,
        "median": 2.5,
        "variance": 1.25,
        "stdev": 1.118033988749895,
        "quantiles": {
          "q1": 1.75,
          "q2": 2.5,
          "q3": 3.25
        }
      }
    },
    {
      "id": "singleton",
      "title": "A single observation",
      "input": {
        "values": [
          7
        ]
      },
      "expected_output": {
        "count": 1,
        "mean": 7,
        "median": 7,
        "variance": 0,
        "stdev": 0,
        "quantiles": {
          "q1": 7,
          "q2": 7,
          "q3": 7
        }
      }
    }
  ],
  "self_test": {
    "demonstrations": [
      "four-values",
      "singleton"
    ]
  },
  "limitations": [
    "1 to 10000 finite numbers, each between -1e12 and 1e12 inclusive. Booleans and numeric strings are rejected.",
    "Population statistics summarize only the supplied values; no confidence interval, missing-value inference or causal conclusion is computed.",
    "Binary floating-point rounding, including underflow for extremely small variances, applies. Quartiles use the explicitly documented inclusive convention."
  ],
  "failure_modes": [
    {
      "condition": "Missing, empty, oversized, non-numeric or out-of-range data.",
      "symptom": "Input validation or capability error.",
      "recovery": "Supply a bounded nonempty numeric list; do not encode expressions or missing values."
    }
  ],
  "provenance": {
    "origin": "builder"
  },
  "stability": "experimental"
}
