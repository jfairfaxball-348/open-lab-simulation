{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-lab:schema:evidence-export:v1",
  "title": "Portable study evidence export",
  "description": "Portable study evidence export; research interchange only, not a world/runtime contract.",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "study_path",
    "study_sha256",
    "exporter",
    "files",
    "omissions",
    "cells",
    "constant_checks"
  ],
  "properties": {
    "schema": {
      "const": "open-lab/evidence-export",
      "description": "Schema."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Document version; readers refuse unsupported major or newer minor versions."
    },
    "study_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*:)[^\\x00-\\x1f]+$",
      "description": "Study path."
    },
    "study_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Study sha256."
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "source_sha256"
      ],
      "properties": {
        "id": {
          "const": "ols-evidence"
        },
        "version": {
          "const": "1.0.0"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Study sha256."
        }
      },
      "description": "Exporter."
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1,
      "description": "Files."
    },
    "omissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 0,
      "description": "Omissions."
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 1,
      "description": "Cells."
    },
    "constant_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "pointer",
          "status",
          "cells"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "status": {
            "enum": [
              "equal",
              "different",
              "missing"
            ]
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "maxLength": 128,
              "description": "Study id."
            },
            "minItems": 1
          }
        }
      },
      "minItems": 0,
      "description": "Constant checks."
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*:)[^\\x00-\\x1f]+$",
          "description": "Study path."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Study sha256."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_sha256",
        "configuration_matches",
        "final_state",
        "reason",
        "world_digest",
        "policy_sha256",
        "model",
        "initial_state",
        "provider_ledger_present",
        "provider_terminal_codes"
      ],
      "properties": {
        "event_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Study sha256."
        },
        "configuration_matches": {
          "type": "boolean"
        },
        "final_state": {
          "enum": [
            "completed",
            "failed",
            "paused",
            "terminated"
          ]
        },
        "reason": {
          "type": "string"
        },
        "world_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Study sha256."
        },
        "policy_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Study sha256."
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "provider_id",
            "weight_digest",
            "settings"
          ],
          "properties": {
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "weight_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "Study sha256."
                },
                {
                  "type": "null"
                }
              ]
            },
            "settings": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "initial_state": {
          "enum": [
            "empty",
            "nonempty",
            "unknown"
          ]
        },
        "provider_ledger_present": {
          "type": "boolean"
        },
        "provider_terminal_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "role",
        "declared_status",
        "archive_path",
        "record",
        "findings"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "maxLength": 128,
          "description": "Study id."
        },
        "role": {
          "enum": [
            "pilot",
            "evaluation",
            "capability_check",
            "engineering"
          ]
        },
        "declared_status": {
          "enum": [
            "recorded",
            "not_started",
            "launch_failed",
            "interrupted"
          ]
        },
        "archive_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*:)[^\\x00-\\x1f]+$",
              "description": "Study path."
            },
            {
              "type": "null"
            }
          ]
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      }
    }
  }
}
