FROM docker.io/library/python@sha256:05a994d2344eb364cc186910f4fc8786a38215f39f00d0acc25bff33a08f4177

# Provisioned by the operator, never by an inhabitant or a runtime launch.
COPY requirements.lock /opt/open-lab-workshop/requirements.lock
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes \
    -r /opt/open-lab-workshop/requirements.lock && python -m pip check
COPY inventory.py /opt/open-lab-workshop/inventory.py
RUN python /opt/open-lab-workshop/inventory.py
